{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthApi": {
    "BaseUrl": "http://localhost:4000/api/auth",
    "JwksUrl": "http://localhost:4000/api/auth/jwks",
    "Issuer": "http://localhost:4000",
    "Audience": "http://localhost:5278"
  },
  "RabbitMq": {
    "UserDelete": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "ExchangeName": "auth_events",
      "QueueName": "auth_events_handler",
      "RoutingKey": "user.deleted",
      "DeliveryLimit": 5
    }
  }
}
